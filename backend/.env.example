# Server Configuration
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=info

# Database Configuration
# For SQLite (local testing):
DATABASE_TYPE=sqlite
DATABASE_URL=sqlite+aiosqlite:///./whatsapp_chat.db

# For MySQL (production):
# DATABASE_TYPE=mysql
# DATABASE_URL=mysql+pymysql://whatsapp_user:password@localhost:3306/whatsapp_chat

# Database Pool Settings (for MySQL)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600
DB_ECHO=false

# Meta WhatsApp API
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_API_TOKEN=your_meta_api_token
WEBHOOK_VERIFY_TOKEN=your_custom_verify_token_string
WHATSAPP_API_VERSION=v18.0

# JWT Authentication
JWT_SECRET=your_super_secret_key_change_this_in_production_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION=86400

# CORS (for frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Server
HOST=0.0.0.0
PORT=8000
